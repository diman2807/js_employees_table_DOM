"use strict";
// write code here
var body = document.querySelector("body");
var thead = document.querySelector("thead");
var tbody = document.querySelector("tbody");
// це пустий об'єкт, ключ це індех колонки, а значення це напрям
var sortDirections = {};
function parseSalary(str) {
    return Number(str.replace(/[^\d.-]/g, ""));
}
function formatSalary(value) {
    // Перетворюємо рядок на число
    var number = typeof value === "string" ? Number(value.replace(/[^\d.-]/g, "")) : value;
    // Форматуємо число з комами і додаємо $
    return "$" + number.toLocaleString("en-US");
}
function sort(table, target) {
    var rows = Array.from(table.rows);
    var ths = Array.from(thead.querySelectorAll("th"));
    var indexOfColumn = ths.indexOf(target);
    // це перемикач коли викликаємо ф-цію, якщо було true стане false і навпаки
    sortDirections[indexOfColumn] = !sortDirections[indexOfColumn];
    // це напрям сортування, якщо true - за зростання, якщо false - за спаданням
    var ascending = sortDirections[indexOfColumn];
    var sortedRows = rows.sort(function(row1, row2) {
        var a = row1.cells[indexOfColumn].textContent.trim();
        var b = row2.cells[indexOfColumn].textContent.trim();
        var compare = 0;
        if (indexOfColumn === 3) // числове порівняння для "Age"
        compare = Number(a) - Number(b);
        else if (indexOfColumn === 4) // числове порівняння для "Salary"
        compare = parseSalary(a) - parseSalary(b);
        else // текстове порівняння
        compare = a.localeCompare(b);
        return ascending ? compare : -compare;
    });
    table.innerHTML = "";
    sortedRows.forEach(function(row) {
        return table.append(row);
    });
}
function showNotification(type, title, description) {
    // Якщо є попереднє повідомлення — видаляємо
    var oldMessage = document.querySelector('[data-qa="notification"]');
    if (oldMessage) oldMessage.remove();
    var message = document.createElement("div");
    message.classList.add("notification", type);
    message.dataset.qa = "notification";
    var messageTitle = document.createElement("h2");
    messageTitle.classList.add("title");
    messageTitle.textContent = title;
    var messageDescription = document.createElement("p");
    messageDescription.textContent = description;
    message.append(messageTitle, messageDescription);
    body.append(message);
    setTimeout(function() {
        return message.remove();
    }, 2000);
}
thead.addEventListener("click", function(e) {
    var myTarget = e.target.closest("th");
    if (!myTarget) return;
    sort(tbody, myTarget);
});
tbody.addEventListener("click", function(e) {
    var rows = Array.from(tbody.rows);
    var beforeSelected = rows.find(function(tr) {
        return tr.classList.contains("active");
    });
    if (beforeSelected) beforeSelected.classList.remove("active");
    var selectedRow = e.target.closest("tr");
    if (!selectedRow) return;
    selectedRow.classList.add("active");
});
var form = document.createElement("form");
form.classList.add("new-employee-form");
var headers = Array.from(thead.querySelectorAll("th"));
// Опції для select полів (можна розширювати)
var selectOptions = {
    Office: [
        "Tokyo",
        "Singapore",
        "London",
        "New York",
        "Edinburgh",
        "San Francisco"
    ]
};
headers.forEach(function(header) {
    var fieldName = header.textContent.trim();
    var fieldElement;
    if (selectOptions[fieldName]) {
        fieldElement = document.createElement("select");
        selectOptions[fieldName].forEach(function(optionValue) {
            var option = document.createElement("option");
            option.value = optionValue;
            option.textContent = optionValue;
            fieldElement.append(option);
        });
    } else {
        fieldElement = document.createElement("input");
        fieldElement.name = fieldName.toLocaleLowerCase();
        if (fieldElement.name === "age" || fieldElement.name === "salary") fieldElement.type = "number";
        else fieldElement.type = "text";
    }
    fieldElement.required = true;
    var label = document.createElement("label");
    label.textContent = "".concat(fieldName, ":");
    fieldElement.dataset.qa = fieldName.toLowerCase();
    label.append(fieldElement);
    form.append(label);
});
var button = document.createElement("button");
button.textContent = "Save to table";
form.append(button);
body.append(form);
form.addEventListener("submit", function(e) {
    var checkArray = [];
    e.preventDefault();
    var newTr = document.createElement("tr");
    headers.forEach(function(header) {
        var fieldName = header.textContent.trim().toLowerCase();
        var field = form.querySelector('[data-qa="'.concat(fieldName, '"]'));
        var checkBoolien = true;
        var value;
        if (fieldName === "age") {
            value = Number(field.value);
            if (value < 18 || value > 90 || !isFinite(value)) checkBoolien = false;
        } else if (fieldName === "salary") {
            if (!isFinite(field.value)) checkBoolien = false;
            value = formatSalary(field.value);
        } else {
            value = field.value.trim();
            // Для текстових полів перевіряємо, що не пусте
            if (!value) checkBoolien = false;
            // Додаткова перевірка мін. довжини тільки для Name
            if (fieldName === "name" && value.length < 4) checkBoolien = false;
        }
        if (!checkBoolien) checkArray.push(checkBoolien);
        var td = document.createElement("td");
        td.textContent = value;
        newTr.append(td);
    });
    var message = document.createElement("div");
    message.classList.add("notification");
    message.dataset.qa = "notification";
    var messageTitle = document.createElement("h2");
    messageTitle.classList.add("title");
    var messageDesription = document.createElement("p");
    messageDesription.style.whiteSpace = "pre-line";
    if (checkArray.length > 0) {
        showNotification("error", "Error", "Please enter valid values, then try again.");
        return;
    }
    showNotification("success", "Success", "Your data successfully added to the table.");
    tbody.append(newTr);
});
// блокуємо будь-яке виділення тексту в tbody
tbody.addEventListener("selectstart", function(e) {
    e.preventDefault();
});
tbody.addEventListener("dblclick", function(e) {
    var currentCell = e.target.closest("td");
    if (!currentCell) return;
    // Якщо вже є активне поле вводу — не дозволяємо створювати ще одне
    var existingInput = tbody.querySelector("input.cell-input");
    if (existingInput) return;
    // Зберігаємо старе значення
    var oldValue = currentCell.textContent.trim();
    var input = document.createElement("input");
    input.classList.add("cell-input");
    currentCell.textContent = "";
    currentCell.append(input);
    input.focus();
    var saveValue = function() {
        var newValue = input.value.trim();
        // якщо нічого не вводили буде старе
        currentCell.textContent = newValue || oldValue;
    };
    input.addEventListener("blur", saveValue);
    input.addEventListener("keydown", function(evnt) {
        if (evnt.key === "Enter") saveValue();
    });
});

